<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. The app is dark-only, matching the web UI. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- Theme applied by BridgeActivity once the WebView is up. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_elev</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch theme: a plain dark window instead of a splash image. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/bg</item>
        <item name="windowSplashScreenBackground">@color/bg</item>
    </style>
</resources>
